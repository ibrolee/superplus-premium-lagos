{
  "expo": {
    "name": "Super Plus Fitness",
    "slug": "superplus-fitness",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "superplus",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.superplusfitness.app"
    },
    "android": {
      "package": "com.superplusfitness.app"
    },
    "plugins": [
      "expo-router",
      "expo-splash-screen",
      [
        "expo-notifications",
        {
          "color": "#EF2B2D",
          "defaultChannel": "membership-reminders"
        }
      ]
    ],
    "owner": "ibrolee98",
    "extra": {
      "eas": {
        "projectId": "98a7285c-045e-49e6-8f0f-f46a1bc145ae"
      }
    }
  }
}
